{
  "name": "tutim-classic",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run start --workspace tutim_client",
    "server": "npm run start --workspace tutimserver",
    "build": "npm run build --workspace tutim_client",
    "build:pages": "npm run build --workspace tutim_client -- --mode demo",
    "preview:pages": "npm run preview --workspace tutim_client -- --mode demo",
    "test:pages": "node tests/pages-browser.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run build && npm test",
    "test:browser": "node tests/browser.cjs",
    "lint": "eslint client/src server tests"
  },
  "devDependencies": {
    "supertest": "7.3.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0"
  }
}
